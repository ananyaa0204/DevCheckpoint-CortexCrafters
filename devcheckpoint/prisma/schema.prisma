// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One selected local Git repository. No repository content is copied here.
model Project {
  id           String    @id @default(uuid())
  name         String
  localPath    String    @unique @map("local_path")
  repoRoot     String    @map("repo_root")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastOpenedAt DateTime? @map("last_opened_at")

  tasks Task[]

  @@index([lastOpenedAt])
  @@map("projects")
}

// What the developer is currently working on within a project.
model Task {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  branch      String?
  notes       String?
  status      String    @default("ACTIVE")
  startedAt   DateTime  @default(now()) @map("started_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]

  @@index([projectId, status])
  @@map("tasks")
}

// An immutable snapshot of task + Git context at a point in time.
// No AI involvement yet: contextSnapshotJson is a deterministic summary
// built from captured data, never invented. generationStatus mirrors the
// enum from docs/DevCheckpoint_Backend_Schema_Document.docx so it is ready
// for "success" / "failed" once AI generation is wired up later.
model Checkpoint {
  id                  String   @id @default(uuid())
  taskId              String   @map("task_id")
  createdAt           DateTime @default(now()) @map("created_at")
  branch              String?
  gitStatusSummary    String?  @map("git_status_summary")
  diffText            String?  @map("diff_text")
  commitsJson         String?  @map("commits_json")
  developerNote       String?  @map("developer_note")
  contextSnapshotJson String   @map("context_snapshot_json")
  generationStatus    String   @default("raw_only") @map("generation_status")

  task  Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  files ChangedFile[]

  @@index([taskId, createdAt])
  @@map("checkpoints")
}

// File metadata relevant to a saved checkpoint (snapshot-scoped).
model ChangedFile {
  id           String @id @default(uuid())
  checkpointId String @map("checkpoint_id")
  filePath     String @map("file_path")
  changeType   String @map("change_type")

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@map("checkpoint_files")
}

// Non-secret application preferences (Ollama endpoint, theme, etc.).
model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
