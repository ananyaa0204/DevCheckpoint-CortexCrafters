// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// One selected local Git repository. No repository content is copied here.
model Project {
  id           String    @id @default(uuid())
  name         String
  localPath    String    @unique @map("local_path")
  repoRoot     String    @map("repo_root")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lastOpenedAt DateTime? @map("last_opened_at")

  tasks Task[]

  @@index([lastOpenedAt])
  @@map("projects")
}

// What the developer is currently working on within a project.
model Task {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  description String?
  branch      String?
  notes       String?
  status      String    @default("ACTIVE")
  startedAt   DateTime  @default(now()) @map("started_at")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints Checkpoint[]
  commandLogs CommandLog[]
  errorLogs   ErrorLog[]
  handoffs    Handoff[]

  @@index([projectId, status])
  @@map("tasks")
}

// An immutable snapshot of task + Git context at a point in time.
//
// contextSnapshotJson is always a deterministic summary built from
// captured data — never AI-generated. aiSummaryJson is the separate,
// clearly-distinguished Qwen output (task/changes/blocker/attempts/
// importantFiles/nextStep), present only when generationStatus is
// COMPLETED. generationStatus: PENDING | GENERATING | COMPLETED | FAILED
// | SKIPPED (Ollama unavailable/model missing). A checkpoint is always
// saved regardless of AI outcome — see AGENT_RULES.md / ARCHITECTURE.md.
model Checkpoint {
  id                  String   @id @default(uuid())
  taskId              String   @map("task_id")
  createdAt           DateTime @default(now()) @map("created_at")
  branch              String?
  gitStatusSummary    String?  @map("git_status_summary")
  diffText            String?  @map("diff_text")
  commitsJson         String?  @map("commits_json")
  developerNote       String?  @map("developer_note")
  contextSnapshotJson String   @map("context_snapshot_json")
  aiSummaryJson       String?  @map("ai_summary_json")
  generationStatus    String   @default("SKIPPED") @map("generation_status")
  generationError     String?  @map("generation_error")

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  files       ChangedFile[]
  commandLogs CommandLog[]
  errorLogs   ErrorLog[]
  handoffs    Handoff[]

  @@index([taskId, createdAt])
  @@map("checkpoints")
}

// File metadata relevant to a saved checkpoint (snapshot-scoped).
model ChangedFile {
  id           String @id @default(uuid())
  checkpointId String @map("checkpoint_id")
  filePath     String @map("file_path")
  changeType   String @map("change_type")

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@map("checkpoint_files")
}

// A manually pasted command the developer wants remembered (no automatic
// terminal hooking — see AGENT_RULES.md §16). Content is sanitized the
// same way as any other captured context before it is ever persisted.
model CommandLog {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  checkpointId String?  @map("checkpoint_id")
  command      String
  exitStatus   Int?     @map("exit_status")
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("command_logs")
}

// A manually pasted error/traceback the developer wants remembered.
model ErrorLog {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  checkpointId String?  @map("checkpoint_id")
  message      String
  source       String?
  createdAt    DateTime @default(now()) @map("created_at")

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  checkpoint Checkpoint? @relation(fields: [checkpointId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@map("error_logs")
}

// A saved, shareable handoff generated from one checkpoint. Local-only —
// there is no cloud sharing or team backend; "sharing" means exportable
// Markdown text.
model Handoff {
  id           String   @id @default(uuid())
  checkpointId String   @map("checkpoint_id")
  taskId       String   @map("task_id")
  markdown     String
  createdAt    DateTime @default(now()) @map("created_at")

  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("handoffs")
}

// Non-secret application preferences (Ollama endpoint, theme, etc.).
model Settings {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
